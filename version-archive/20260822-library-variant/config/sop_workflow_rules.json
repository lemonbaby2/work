{
  "principle": "先核对工艺流程、动作/手势和结果证据；暂不把板内器件型号正确性作为默认判定项。",
  "inspection_profiles": {
    "assembly": {
      "label": "组装流程",
      "focus": ["流程顺序", "标签信息", "手法模式", "漏装/错序"],
      "evidence": ["工位动作", "手进入/离开画面", "屏幕或SOP对照内容"]
    },
    "test": {
      "label": "测试岗位",
      "focus": ["流程顺序", "手势", "电脑显示内容一致性", "测试结果"],
      "evidence": ["测试软件界面", "当前工单/产品信息", "PASS/NG结果"]
    },
    "programming": {
      "label": "烧录流程",
      "focus": ["插电流程", "烧录步骤", "程序/版本信息", "烧录结果"],
      "evidence": ["电源连接", "烧录工具界面", "版本号/校验结果"]
    },
    "screw": {
      "label": "打螺丝流程",
      "focus": ["取螺丝", "对位", "是否打螺丝", "数量/顺序", "工具姿态"],
      "evidence": ["螺丝进入孔位", "电批/螺丝刀接触", "完成状态", "扭矩报文（如有）"]
    },
    "soldering": {
      "label": "焊接流程",
      "focus": ["手势与顺序", "烙铁/焊枪接触", "送锡/撤锡", "温度/加热时长"],
      "evidence": ["H3-H7动作", "温度曲线", "焊接过程参数", "PASS/NG结果"]
    }
  },
  "default_exclusions": ["板内器件型号和BOM正确性（除非该工位明确要求）"],
  "result_labels": ["PASS", "NG", "报警", "返修", "待复核"],
  "boundary": "开始帧为手/板/工具进入画面，结束帧为手/板/工具离开画面或步骤结果出现。"
}
