[Unit]
Description=SOP local version index on port 8099
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/xjai/Desktop/sop xjai/work-delivery-repo/deploy/versioned
ExecStart=/usr/bin/python3 -m http.server 8099 --bind 0.0.0.0 --directory "/home/xjai/Desktop/sop xjai/work-delivery-repo/deploy/versioned"
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
