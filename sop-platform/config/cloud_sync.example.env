# Google Drive uses an rclone remote authorized with OAuth.
# Configure each remote root to the corresponding folder ID, then use the remote root here.
SOP_GOOGLE_SOURCE_URL=
SOP_GOOGLE_OUTPUT_URL=
SOP_GOOGLE_SOURCE=gdrive-sop-source:
SOP_GOOGLE_OUTPUT=gdrive-sop-output:

# Baidu Netdisk requires an independently authorized sync client.
# {destination} is replaced with runtime/cloud_inbox/baidu without invoking a shell.
SOP_BAIDU_SOURCE_URL=
SOP_BAIDU_SYNC_COMMAND=BaiduPCS-Go download /daily-sop-videos --saveto {destination}

# {source} is replaced with runtime/annotation_exports. Set the remote path to the
# authorized Ningbo SOP folder in the local BaiduPCS-Go account.
SOP_BAIDU_UPLOAD_COMMAND=BaiduPCS-Go upload {source} /宁波SoP项目/标注结果
